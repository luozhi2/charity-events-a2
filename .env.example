# =====================================================================
#  Database connection settings for the Charity Events API
#
#  Copy this file to  .env  and adjust the values for your MySQL server.
#  The .env file holds real credentials and must NOT be committed to
#  GitHub - it is listed in .gitignore.
#
#  The portable MySQL 8.0.46 server shipped with this project
#  (start_mysql.cmd) uses root with an empty password.
# =====================================================================

# MySQL server
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# Database created by database/charityevents_db.sql - do not rename it,
# the assessment brief specifies this name.
DB_NAME=charityevents_db

# Express API
PORT=3000
